# .env.example

# Entorno
ENVIRONMENT=development

# LLM - Claude es la integracion activa. Ollama queda como alternativa opcional para desarrollo local sin API key.
LLM_PROVIDER=claude
# 127.0.0.1 y no localhost: Ollama y el servidor de embeddings escuchan solo en IPv4,
# y en Windows `localhost` prueba antes ::1 y espera ~2 s a que falle. Dentro de Docker
# manda docker-compose.yml.
OLLAMA_HOST=http://127.0.0.1:11434
# Modelos locales, en orden de preferencia:
# gemma4:e2b-it-qat, phi4-mini:3.8b, llama3.2:3b. Por CPU tardan de 1 a 2 minutos por respuesta: de ahi los 300 s.
OLLAMA_MODEL=gemma4:e2b-it-qat
OLLAMA_TIMEOUT_SECONDS=300

# LLMs externos - se activan en etapas posteriores de integracion.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Embeddings - Cohere embed-multilingual-v3.0 es el proveedor activo.
# El servicio de embeddings sigue corriendo FUERA de Docker via pipeline/embedding_server.py (backend le habla por HTTP, ver EMBEDDING_SERVICE_URL).
# EMBEDDING_PROVIDER=sentence-transformers queda como alternativa local sin necesitar COHERE_API_KEY.
EMBEDDING_PROVIDER=cohere
COHERE_API_KEY=your_key_here
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_SERVICE_URL=http://127.0.0.1:8500

# Reranking - cross-encoder local es el proveedor por defecto: sin rate limit, sin costo,
# sin llamada de red, corre en el mismo servicio que los embeddings (pipeline/embedding_server.py).
# RERANKER_PROVIDER=cohere usa Cohere Rerank en su lugar (produccion, requiere COHERE_API_KEY
# con capacidad suficiente -- una clave Trial de 10 llamadas/min no alcanza para uso real).
RERANKER_PROVIDER=cross-encoder

# Vector store
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000

# Base de datos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asistente_educacion

# Autenticacion
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (separar multiples origenes con coma)
CORS_ORIGINS=http://localhost:5173
